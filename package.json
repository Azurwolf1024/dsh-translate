{
  "name": "dsh-translate",
  "version": "1.4.0",
  "description": "Translate with a local Ollama model inside DeepSeek Harness: in-page selection popup, system-wide selection (UI Automation -> clipboard -> OCR fallback), text and file translation. Stateless requests, unloads the model when idle.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "tests/*.mjs",
    "tests/fixtures/*",
    "helper/*.ps1",
    "docs/*.png",
    "CHANGELOG.md",
    "LICENSE",
    ".gitignore"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-0 <0.3.0-0"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "translation",
    "translate",
    "ollama",
    "local-llm",
    "privacy",
    "selection-translate",
    "ocr",
    "uia"
  ],
  "author": "Azurwolf1024",
  "homepage": "https://github.com/Azurwolf1024/dsh-translate#readme",
  "bugs": {
    "url": "https://github.com/Azurwolf1024/dsh-translate/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Azurwolf1024/dsh-translate.git"
  },
  "scripts": {
    "test": "node tests/selftest.mjs && node tests/client_selftest.mjs",
    "test:live": "node tests/selftest.mjs --live",
    "selftest:helper": "powershell -NoProfile -STA -ExecutionPolicy Bypass -File helper/dsh-translate-capture.ps1 -SelfTest",
    "selftest:ocr": "powershell -NoProfile -STA -ExecutionPolicy Bypass -File helper/dsh-translate-capture.ps1 -TestOcr",
    "selftest:overlay": "powershell -NoProfile -STA -ExecutionPolicy Bypass -File helper/dsh-translate-capture.ps1 -TestOverlay"
  }
}
